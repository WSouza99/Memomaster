<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MemoMaster Web 2.0</title>
    <style>
        /* --- ESTILO (CSS) --- */
        :root {
            --bg: #121212;
            --card-bg: #1e1e1e;
            --text: #e0e0e0;
            --primary: #bb86fc;
            --success: #03dac6;
            --danger: #cf6679;
            --warning: #f1c40f;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }
        .container {
            width: 90%;
            max-width: 600px;
            margin-top: 20px;
            padding-bottom: 50px;
        }
        h1 { text-align: center; color: var(--primary); margin-bottom: 5px; }
        .subtitle { text-align: center; color: #666; font-size: 0.9em; margin-bottom: 20px; }
        
        /* Navegação */
        .nav {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
        }
        button {
            padding: 10px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.2s;
        }
        button:hover { opacity: 0.9; }
        .btn-nav { background-color: #333; color: white; }
        .btn-nav.active { background-color: var(--primary); color: black; }
        
        /* Telas */
        .screen { display: none; }
        .screen.active { display: block; animation: fadeIn 0.3s; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        /* Card de Estudo */
        .flashcard {
            background-color: var(--card-bg);
            padding: 40px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            min-height: 200px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }
        .topic-badge {
            position: absolute;
            top: 15px;
            left: 50%;
            transform: translateX(-50%);
            background: #333;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.8em;
            color: var(--primary);
        }
        .answer-area { margin-top: 20px; border-top: 1px solid #333; padding-top: 20px; }
        .hidden { display: none; }
        
        /* Formulários */
        input, select {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            background: #2c2c2c;
            border: 1px solid #444;
            color: white;
            border-radius: 5px;
            box-sizing: border-box;
        }
        input:focus { outline: 1px solid var(--primary); }
        
        /* Botões de Ação */
        .btn-action { width: 100%; padding: 15px; font-size: 1.1em; background: var(--primary); color: #000; margin-top: 10px; }
        .btn-grade { width: 30%; margin: 5px; color: black; font-size: 0.9em; }
        
        .bg-red { background-color: var(--danger); color: white; }
        .bg-yellow { background-color: var(--warning); }
        .bg-green { background-color: var(--success); }
        .bg-blue { background-color: #3498db; color: white; }

        /* Tabela */
        table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 0.9em; }
        th, td { padding: 12px 8px; text-align: left; border-bottom: 1px solid #333; }
        th { color: var(--primary); }
        .actions-cell { text-align: right; }
        .btn-sm { padding: 5px 10px; font-size: 0.8em; margin-left: 5px; }

        /* Backup Area */
        .backup-area {
            margin-top: 30px;
            padding: 15px;
            border: 1px dashed #555;
            border-radius: 10px;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>🧠 MemoMaster V2</h1>
        <p class="subtitle">Agora com Backup & Atalhos (Espaço, 1, 2, 3)</p>
        
        <div class="nav">
            <button class="btn-nav active" onclick="showScreen('study')">Estudar</button>
            <button class="btn-nav" onclick="showScreen('add')">Adicionar</button>
            <button class="btn-nav" onclick="showScreen('list')">Lista & Backup</button>
        </div>

        <div id="study" class="screen active">
            <div id="stats" style="text-align: center; margin-bottom: 10px; color: #888;"></div>
            
            <div id="card-display" class="flashcard">
                <span id="card-topic" class="topic-badge">...</span>
                <h2 id="card-question">Carregando...</h2>
                
                <div id="answer-section" class="answer-area hidden">
                    <h3 id="card-answer" style="color: var(--success);"></h3>
                    <div style="margin-top: 20px;">
                        <p style="font-size: 0.8em; color: #888;">Como foi sua memória?</p>
                        <button class="btn-grade bg-red" onclick="processGrade(0)">[1] Errei</button>
                        <button class="btn-grade bg-yellow" onclick="processGrade(3)">[2] Difícil</button>
                        <button class="btn-grade bg-green" onclick="processGrade(5)">[3] Fácil</button>
                    </div>
                </div>
            </div>
            
            <button id="btn-show" class="btn-action" onclick="showAnswer()">[Espaço] Mostrar Resposta</button>
        </div>

        <div id="add" class="screen">
            <h2>Novo Flashcard</h2>
            <label>Matéria / Tópico</label>
            <input type="text" id="new-topic" placeholder="Ex: Inglês, JS, História...">
            
            <label>Pergunta (Frente)</label>
            <input type="text" id="new-question" placeholder="O que você quer lembrar?">
            
            <label>Resposta (Verso)</label>
            <input type="text" id="new-answer" placeholder="A resposta correta">
            
            <button class="btn-action" onclick="addCard()">Salvar Card</button>
        </div>

        <div id="list" class="screen">
            <h2>Gerenciar Cards</h2>
            
            <div style="overflow-x: auto;">
                <table>
                    <thead><tr><th>Matéria</th><th>Pergunta</th><th>Revisão</th><th>Ações</th></tr></thead>
                    <tbody id="cards-table"></tbody>
                </table>
            </div>

            <div class="backup-area">
                <h3>💾 Backup e Restauração</h3>
                <p style="font-size: 0.8em; color: #888;">Salve seus dados para não perdê-los.</p>
                <button class="bg-blue" onclick="exportData()">⬇️ Baixar Backup</button>
                <button class="bg-yellow" onclick="document.getElementById('file-input').click()">⬆️ Restaurar Backup</button>
                <input type="file" id="file-input" style="display: none;" onchange="importData(this)">
                <br><br>
                <button onclick="clearData()" style="background: transparent; color: var(--danger); border: 1px solid var(--danger);">🗑️ Apagar Tudo</button>
            </div>
        </div>
    </div>

    <script>
        /* --- LÓGICA DO PROGRAMA --- */
        
        let cards = JSON.parse(localStorage.getItem('cards')) || [];
        let sessionQueue = [];
        let currentCard = null;

        // Inicialização
        window.onload = () => {
            prepareSession();
            renderList();
            setupShortcuts();
        };

        function getTodayString() {
            // Correção de Fuso Horário (Pega data local, não UTC)
            const date = new Date();
            date.setMinutes(date.getMinutes() - date.getTimezoneOffset());
            return date.toISOString().split('T')[0];
        }

        function save() {
            localStorage.setItem('cards', JSON.stringify(cards));
            renderList(); // Atualiza a lista sempre que salva
        }

        // Navegação
        function showScreen(id) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.btn-nav').forEach(b => b.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            
            // Ativa visualmente o botão clicado (busca pelo texto ou onclick)
            const buttons = document.querySelectorAll('.btn-nav');
            buttons.forEach(btn => {
                if(btn.getAttribute('onclick').includes(id)) btn.classList.add('active');
            });

            if(id === 'study') prepareSession();
        }

        /* --- SISTEMA DE ESTUDO --- */

        function prepareSession() {
            const today = getTodayString();
            // Filtra cards vencidos ou novos
            sessionQueue = cards.filter(c => c.next_review <= today);
            updateStats();
            loadNextCard();
        }

        function updateStats() {
            const count = sessionQueue.length;
            const text = count === 0 ? "Tudo limpo por hoje!" : `Faltam ${count} cards para hoje`;
            document.getElementById('stats').innerText = text;
        }

        function loadNextCard() {
            document.getElementById('answer-section').classList.add('hidden');
            const btnShow = document.getElementById('btn-show');
            btnShow.style.display = 'block';
            btnShow.innerText = "[Espaço] Mostrar Resposta";

            if (sessionQueue.length === 0) {
                document.getElementById('card-topic').innerText = "Fim";
                document.getElementById('card-question').innerText = "🎉 Parabéns! Sessão concluída.";
                document.getElementById('card-answer').innerText = "";
                btnShow.style.display = 'none';
                currentCard = null;
                return;
            }

            currentCard = sessionQueue[0];
            document.getElementById('card-topic').innerText = currentCard.topic;
            document.getElementById('card-question').innerText = currentCard.question;
            document.getElementById('card-answer').innerText = currentCard.answer;
        }

        function showAnswer() {
            if (!currentCard) return;
            document.getElementById('answer-section').classList.remove('hidden');
            document.getElementById('btn-show').style.display = 'none';
        }

        // Algoritmo SM-2 modificado
        function processGrade(grade) {
            if (!currentCard) return;

            const index = cards.indexOf(currentCard);
            if (index === -1) return;

            // Lógica de Repetição na Mesma Sessão
            if (grade < 3) {
                // Se errou, o card vai pro final da fila de hoje para rever
                alert("Não desanime! Vamos ver este card novamente ainda hoje.");
                sessionQueue.push(currentCard);
                
                // Reseta os atributos para o algoritmo considerar como novo aprendizado amanhã
                cards[index].n_revisoes = 0;
                cards[index].interval = 1;
                cards[index].ef = 2.5;
            } else {
                // Se acertou, calcula a próxima data (Algoritmo SM-2)
                let ef = cards[index].ef + (0.1 - (5 - grade) * (0.08 + (5 - grade) * 0.02));
                if (ef < 1.3) ef = 1.3;
                
                cards[index].ef = ef;
                cards[index].n_revisoes += 1;

                if (cards[index].n_revisoes === 1) {
                    cards[index].interval = 1;
                } else if (cards[index].n_revisoes === 2) {
                    cards[index].interval = 6;
                } else {
                    cards[index].interval = Math.ceil(cards[index].interval * ef);
                }
            }

            // Define a data da próxima revisão
            const nextDate = new Date();
            nextDate.setDate(nextDate.getDate() + cards[index].interval);
            // Ajuste de fuso horário simples
            nextDate.setMinutes(nextDate.getMinutes() - nextDate.getTimezoneOffset());
            cards[index].next_review = nextDate.toISOString().split('T')[0];

            save();
            
            // Remove o item atual do topo da fila
            sessionQueue.shift();
            updateStats();
            loadNextCard();
        }

        /* --- GERENCIAMENTO DE DADOS --- */

        function addCard() {
            const topic = document.getElementById('new-topic').value || "Geral";
            const q = document.getElementById('new-question').value;
            const a = document.getElementById('new-answer').value;

            if (q && a) {
                cards.push({
                    topic: topic, 
                    question: q, 
                    answer: a,
                    n_revisoes: 0, 
                    ef: 2.5, 
                    interval: 0,
                    next_review: getTodayString()
                });
                save();
                alert('Card Criado!');
                document.getElementById('new-question').value = '';
                document.getElementById('new-answer').value = '';
                document.getElementById('new-question').focus();
            } else {
                alert('Preencha pergunta e resposta');
            }
        }

        // Renderização Segura (Anti-XSS) com Botão de Delete
        function renderList() {
            const tbody = document.getElementById('cards-table');
            tbody.innerHTML = ''; 

            cards.forEach((card, index) => {
                const tr = document.createElement('tr');

                const tdTopic = document.createElement('td');
                tdTopic.textContent = card.topic;

                const tdQuestion = document.createElement('td');
                tdQuestion.textContent = card.question;

                const tdDate = document.createElement('td');
                // Formata data simples (DD/MM)
                const dateParts = card.next_review.split('-');
                tdDate.textContent = `${dateParts[2]}/${dateParts[1]}`;
                if(card.next_review < getTodayString()) tdDate.style.color = "var(--danger)";

                const tdAction = document.createElement('td');
                tdAction.className = 'actions-cell';
                
                const btnDel = document.createElement('button');
                btnDel.textContent = '✖';
                btnDel.className = 'btn-sm bg-red';
                btnDel.onclick = () => deleteCard(index);

                tdAction.appendChild(btnDel);
                tr.append(tdTopic, tdQuestion, tdDate, tdAction);
                tbody.appendChild(tr);
            });
        }

        function deleteCard(index) {
            if(confirm("Tem certeza que deseja apagar este card?")) {
                cards.splice(index, 1);
                save();
                // Se o card apagado estava na fila de hoje, recarrega a sessão
                if(document.getElementById('study').classList.contains('active')) prepareSession();
            }
        }

        function clearData() {
            if(confirm("CUIDADO: Isso apagará TODOS os seus cards. Continuar?")) {
                localStorage.removeItem('cards');
                location.reload();
            }
        }

        /* --- BACKUP E RESTAURAÇÃO --- */

        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(cards));
            const downloadAnchorNode = document.createElement('a');
            downloadAnchorNode.setAttribute("href", dataStr);
            downloadAnchorNode.setAttribute("download", "memomaster_backup.json");
            document.body.appendChild(downloadAnchorNode);
            downloadAnchorNode.click();
            downloadAnchorNode.remove();
        }

        function importData(input) {
            const file = input.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const importedCards = JSON.parse(e.target.result);
                    if (Array.isArray(importedCards)) {
                        cards = importedCards;
                        save();
                        alert("Backup restaurado com sucesso!");
                        location.reload();
                    } else {
                        alert("Arquivo inválido.");
                    }
                } catch (err) {
                    alert("Erro ao ler o arquivo. Verifique se é um JSON válido.");
                }
            };
            reader.readAsText(file);
        }

        /* --- ATALHOS DE TECLADO --- */
        function setupShortcuts() {
            document.addEventListener('keydown', (e) => {
                // Só funciona se estiver na tela de estudo
                if (!document.getElementById('study').classList.contains('active')) return;
                
                // Se a resposta ainda não foi mostrada
                const answerHidden = document.getElementById('answer-section').classList.contains('hidden');

                if (e.code === 'Space') {
                    e.preventDefault(); // Impede scroll da página
                    if (answerHidden) showAnswer();
                }

                // Se a resposta já está visível, permite avaliar
                if (!answerHidden && currentCard) {
                    if (e.key === '1') processGrade(0);
                    if (e.key === '2') processGrade(3);
                    if (e.key === '3') processGrade(5);
                }
            });
        }
    </script>
</body>
</html>
